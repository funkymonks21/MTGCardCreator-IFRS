# Dados baixados/gerados (grandes demais e reproduzíveis via script)
data/raw/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Cache das artes baixadas da API de imagem (reproduzível, ver
# src/pipeline/imagem.py). As FONTES em assets/fonts/ são versionadas.
assets/cache_arte/*
!assets/cache_arte/.gitkeep

# Cache do Gradio (flags/túneis do app.py)
.gradio/

# Renders locais de inspeção (ex.: _sem_arte.png, _com_arte.png)
_*.png

# Ambientes/IDE
.ipynb_checkpoints/
.vscode/
