# Dados baixados/gerados (grandes demais e reproduzíveis via script)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Cache das artes baixadas da API de imagem (reproduzível, ver
# src/pipeline/imagem.py). As FONTES em assets/fonts/ são versionadas.
assets/cache_arte/*
!assets/cache_arte/.gitkeep

# Ambientes/IDE
.ipynb_checkpoints/
.vscode/
